{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
    "axiom3d-conventions": {
      "path": "../docs/axiom3d/conventions.md",
      "description":
        "Blender scene conventions for Axiom3D assets: unit scale, origin placement, naming, mesh health, materials, export rules. Consult when authoring or validating 3D assets.",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
